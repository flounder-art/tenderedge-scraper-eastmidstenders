cat > src/cpv_registry.ts << 'EOF'
export const EM_COUNCILS = [
  'Nottinghamshire County Council',
  'Derbyshire County Council', 
  'Leicestershire County Council',
  'Lincolnshire County Council',
  'Rutland County Council',
  'Nottingham City Council',
  'Derby City Council',
  'Leicester City Council',
];

export const SOCIAL_CARE_CPV = ['85300000', '85310000', '85312000', '85312100', '85320000'];
export const NHS_CPV = ['85100000', '85110000', '85140000', '33600000'];
export const LGR_KEYWORDS = ['reorganisation', 'unitary', 'transition', 'local government reorganisation'];
export const VEGAN_KEYWORDS = ['vegan', 'plant-based', 'meat-free', 'vegetarian catering'];

export function tagTender(t: any) {
  const title = (t.title + ' ' + (t.description || '')).toLowerCase();
  const buyer = t.buyer || '';
  t.is_em_tagged = EM_COUNCILS.some(c => buyer.includes(c));
  t.is_la_tagged = buyer.toLowerCase().includes('council');
  t.is_social_care_tagged = SOCIAL_CARE_CPV.some(cpv => t.cpv_codes?.includes(cpv));
  t.is_lgr_tagged = LGR_KEYWORDS.some(k => title.includes(k));
  t.is_vegan = VEGAN_KEYWORDS.some(k => title.includes(k));
  
  if (t.is_social_care_tagged && t.is_la_tagged) t.vertical = 'la_social_care';
  else if (NHS_CPV.some(cpv => t.cpv_codes?.includes(cpv))) t.vertical = 'nhs';
  else if (t.is_lgr_tagged) t.vertical = 'lgr_transition';
  else t.vertical = 'other';
  
  return t;
}
EOF

